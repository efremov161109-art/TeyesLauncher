<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E17"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="••••\n4G"
            android:textColor="#8E94B8"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sideBtnVoice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_voice_ring"
            android:contentDescription="Голосовой помощник" />

        <ImageButton
            android:id="@+id/sideBtnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="Настройки"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#B0B6D8" />

        <ImageButton
            android:id="@+id/sideBtnApps"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="Приложения"
            android:src="@android:drawable/ic_dialog_dialer"
            android:tint="#B0B6D8" />

        <ImageButton
            android:id="@+id/sideBtnNavi"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="Навигатор"
            android:src="@android:drawable/ic_menu_directions"
            android:tint="#9575CD" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <Button
                android:id="@+id/btnSetDefaultHome"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="10dp"
                android:text="Сделать основным лаунчером"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="EEE dd.MM"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/topVolumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="3dp"
                android:text="🔊 15"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1.55"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_music_gradient"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnSwitchSource"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_card_dark"
                    android:paddingHorizontal="10dp"
                    android:text="Я.Музыка ⇄"
                    android:textColor="#FFCC00"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTrackName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/btnSwitchSource"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Яндекс Музыка"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArtistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTrackName"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Нажмите Play или выберите источник"
                    android:textColor="#D0D8F0"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMusicPrev"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:text="⏮"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnMusicPlay"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="@drawable/bg_circle_btn"
                        android:text="⏸"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btnMusicNext"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:text="⏭"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1.8"
                android:background="@drawable/bg_card_dark"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="км/ч"
                        android:textColor="#8E94B8"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnNaviClose"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_btn"
                        android:text="✕"
                        android:textColor="#FF5252"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#121420"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ЯНДЕКС НАВИГАТОР"
                        android:textColor="#90CAF9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOpenNaviWindow"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:backgroundTint="#2962FF"
                            android:text="В ОКНЕ (50/50)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnOpenNaviFull"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#2A2E45"
                            android:text="НА ВЕСЬ ЭКРАН"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.65"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приложения (удерживайте для замены)"
                    android:textColor="#8E94B8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/appSlot1"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:backgroundTint="#26293E"
                        android:text="Я.Музыка"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/appSlot2"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#26293E"
                        android:text="Эквалайзер"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/appSlot3"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#26293E"
                        android:text="Файлы"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/appSlot4"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#26293E"
                        android:text="YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/appSlotAdd"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="0.8"
                        android:backgroundTint="#26293E"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_card_dark"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Радио"
                        android:textColor="#8E94B8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="FM Тюнер"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRadioPrev"
                            android:layout_width="40dp"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:text="⏮"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <Button
android:id="@+id/btnRadioNext"
android:layout_width="40dp"
android:layout_height="44dp"
android:background="@android:color/transparent"
android:text="⏭"
android:textColor="#FFFFFF"
android:textSize="16sp" />
